# DATAGASE CONFIGURATION
DB_HOST=
DB_PORT=56108
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=90d

# LIVINKEY EMAIL CONFIGURATION
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# LIVINKEY CLOUDINARY CONFIGURATION
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# FIREBASE (Push Notifications)
# ============================================================
ENABLE_PUSH_NOTIFICATIONS=true
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================
# PAYMENT GATEWAY CONFIGURATION
# ============================================

# Merchant UPI ID (Your business UPI ID)
MERCHANT_UPI_ID=
MERCHANT_NAME=Livinkey
MERCHANT_CODE=LIVINKEY

# Enable/Disable Payment Gateway
ENABLE_PAYMENT_GATEWAY=true

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=

# PayU
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENVIRONMENT=

# App URL (for payment callbacks)
APP_URL=

# ------------------------------------------------------------
# TWILIO (WhatsApp Business API)
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional: Content Template SIDs (create these in Twilio Console → Content Template Builder)
# These are strongly recommended for production (required outside 24h window)
TWILIO_OTP_CONTENT_SID=
TWILIO_BILL_CONTENT_SID=
TWILIO_FINE_CONTENT_SID=
TWILIO_EFRRO_CONTENT_SID=

# ------------------------------------------------------------
# WHATSAPP BEHAVIOUR
# ------------------------------------------------------------
# Set to "true" if you want automatic reply when user messages you
WHATSAPP_AUTO_REPLY=
WHATSAPP_AUTO_REPLY_TEXT=

# ---- Added during security hardening ----
# Public URLs used in emails / payment callbacks (must be correct!)
PUBLIC_API_URL=https://api.livinkey.com
WEBSITE_URL=https://livinkey.com
ADMIN_URL=https://admin.livinkey.com
APP_STORE_URL=https://play.google.com/store/apps/details?id=com.livinkey.app
# Extra browser origins allowed to call the API (comma separated, optional)
CORS_ORIGINS=
# Reject WhatsApp/Twilio webhooks that are not signed by Twilio
TWILIO_VALIDATE_WEBHOOK=true
# MySQL connection pool size
DB_POOL_LIMIT=15

# ------------------------------------------------------------
# TWILIO – delivery chain: WhatsApp -> SMS -> e-mail   (see TWILIO_SETUP.md)
# ------------------------------------------------------------
# Order / on-off switch of the channels (remove one to disable it). Default: whatsapp,sms,email
MESSAGING_CHANNELS=whatsapp,sms,email
# Country code used for numbers saved without one (digits only, e.g. 91 for India, 255 for Tanzania)
DEFAULT_COUNTRY_CODE=91
# WhatsApp sender: either the sender number OR a Messaging Service SID (MGxxxxxxxx)
TWILIO_WHATSAPP_MESSAGING_SERVICE_SID=
# SMS sender: a Twilio number (+1..., or an Indian DLT-registered sender) OR a Messaging Service SID
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Approved WhatsApp Content Templates (HXxxxxxxxx). Needed to message people who have not written to you in the last 24h.
TWILIO_CUSTOM_CONTENT_SID=
TWILIO_MAINTENANCE_CONTENT_SID=
# Set to true only if your OTP template has a 2nd variable for the purpose (Login / Forgot Password)
TWILIO_OTP_PURPOSE_VAR=false
# Delivery receipts URL (leave blank to use PUBLIC_API_URL + /api/webhooks/twilio/status)
TWILIO_STATUS_CALLBACK_URL=
